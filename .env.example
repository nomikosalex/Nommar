# Copy to .env and fill in.

# --- Database (Supabase Postgres) ---
# Pooled connection (pgBouncer, port 6543) — used by the app at runtime.
# From Supabase: Project Settings → Database → Connection string → "Transaction" / pooler.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used for migrations only.
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Admin login (seeded by `npm run db:seed`) ---
ADMIN_EMAIL="margarita@nommar.gr"
ADMIN_PASSWORD="change-me"

# --- Session signing secret (long random string in prod) ---
JWT_SECRET="change-me-to-a-long-random-32+-char-secret"

# --- Email (Resend). Blank = log to console in dev. ---
RESEND_API_KEY=""
EMAIL_FROM="Nommar <info@nommar.gr>"
SPA_EMAIL="info@nommar.gr"

# --- Supabase Storage (images) ---
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # server-only, never expose
SUPABASE_STORAGE_BUCKET="images"

# --- Timezone ---
NEXT_PUBLIC_TZ="Europe/Athens"

# --- Canonical origin for absolute links in emails + promo banner ---
# Dev: http://localhost:3000 · Prod: https://nommar.vercel.app (or your domain)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- Reminders cron secret (Vercel Cron sends it as `Authorization: Bearer <secret>`) ---
CRON_SECRET="generate-with: openssl rand -hex 24"

# --- Anthropic (AI-drafted review replies). Blank = drafts are skipped, reviews stay undrafted. ---
# Get a key at https://console.anthropic.com/settings/keys — full steps in REVIEWS-SETUP.md.
ANTHROPIC_API_KEY=""

# --- Google Business Profile (Google reviews sync + reply posting). Blank = sync/post no-op. ---
# Full step-by-step (Cloud Console project, OAuth consent screen, obtaining the
# refresh token, finding the account/location IDs) is in REVIEWS-SETUP.md.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_BUSINESS_ACCOUNT_ID=""
GOOGLE_BUSINESS_LOCATION_ID=""

# --- Review auto-post rule. Default OFF — every reply requires admin approval in /admin/reviews. ---
# When "true": reviews rated 4-5 with no detected negative sentiment auto-post
# the AI draft after 24h if the admin hasn't touched them. Reviews rated 3 or
# below NEVER auto-post, regardless of this setting — see lib/reviews.ts.
REVIEWS_AUTO_POST_ENABLED="false"
